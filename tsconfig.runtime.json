{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "out/runtime-node",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/runtime/**/*.ts",
    "src/shared/runtime-protocol.ts",
    "src/shared/types/file-utils.ts",
    "src/shared/types/branch-utils.ts",
    "src/shared/types/settings.ts",
    "src/main/db/**/*.ts",
    "src/main/services/file-ops.ts",
    "src/main/services/git-service.ts",
    "src/main/services/breed-names.ts",
    "src/main/services/logger.ts",
    "src/main/services/path-utils.ts",
    "src/main/services/worktree-ops.ts",
    "src/main/services/script-runner.ts",
    "src/main/services/port-registry.ts"
  ]
}
