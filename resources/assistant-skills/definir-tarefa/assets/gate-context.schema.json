{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Fitness Contract v2 — gate-context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
    },
    "current_candidate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "implementer_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approved_by": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "contract_sha256",
        "approved_by",
        "approval_ref"
      ]
    },
    "trusted_producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "runner",
              "human",
              "model"
            ]
          },
          "allowed_verifier_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "allowed_verifier_ids"
        ]
      },
      "minItems": 1
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "no_progress_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "iterations",
        "elapsed_seconds",
        "no_progress_iterations",
        "tokens",
        "cost_usd"
      ]
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "none",
        "cancelled",
        "budget_exhausted",
        "external_blocker"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "new_regressions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "current_candidate_id",
    "evaluated_at",
    "implementer_id",
    "approval",
    "trusted_producers",
    "usage",
    "stop_reason",
    "blockers",
    "new_regressions"
  ]
}
