{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Fitness Contract v2 — contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "change_reason": {
      "type": "string"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested_outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_state": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completion_scope": {
          "type": "string",
          "enum": [
            "repository",
            "ci",
            "staging",
            "production"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "requested_outcome",
        "target_state",
        "completion_scope",
        "source_refs"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "environment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "included_paths",
        "excluded_paths",
        "non_goals",
        "environment_ids"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "user_request",
              "user_decision",
              "repository",
              "documentation",
              "adr",
              "api_contract",
              "baseline"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "statement"
        ]
      },
      "minItems": 1
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "question",
          "blocking",
          "status",
          "resolution",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "decision_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "blocking",
          "status",
          "decision_ref"
        ]
      },
      "minItems": 0
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "candidate_id",
        "description",
        "artifact"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "requirement",
              "hard_constraint",
              "regression"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "environment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "verifier_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "required",
          "source_refs",
          "environment_ids",
          "verifier_ids"
        ]
      },
      "minItems": 1
    },
    "verifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "runtime_observation",
              "human_review",
              "llm_rubric"
            ]
          },
          "procedure": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "pass_rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "kind",
          "procedure",
          "pass_rule",
          "max_age_seconds"
        ]
      },
      "minItems": 1
    },
    "optimization_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "direction": {
            "type": "string",
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "measurement_protocol": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "description",
          "direction",
          "unit",
          "measurement_protocol"
        ]
      },
      "minItems": 0
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_no_progress_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_iterations",
        "max_elapsed_seconds",
        "max_no_progress_iterations",
        "max_tokens",
        "max_cost_usd"
      ]
    },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optimize_after_acceptance": {
          "const": false
        }
      },
      "required": [
        "optimize_after_acceptance"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "supersedes_sha256",
    "change_reason",
    "objective",
    "scope",
    "sources",
    "unknowns",
    "assumptions",
    "baseline",
    "criteria",
    "verifiers",
    "optimization_metrics",
    "budget",
    "stop_policy"
  ]
}
